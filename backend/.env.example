# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/visionflow-ai

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# AI Video Provider
# Options: mock | real
AI_VIDEO_PROVIDER=mock

# Real Provider (used only when AI_VIDEO_PROVIDER=real)
AI_VIDEO_API_KEY=
AI_VIDEO_API_BASE=
AI_VIDEO_MODEL=visionflow-motion-v1
